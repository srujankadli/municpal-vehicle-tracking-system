# ==============================================================================
# Municipal Solid Waste Monitoring Platform
# Production Environment Template (.env.example)
#
# IMPORTANT: This file contains NON-PRODUCTION placeholders only.
# In a real municipal production environment, real secrets must be securely
# injected via container runtime / Kubernetes secret stores / Vault.
# ==============================================================================

# Application Environment Mode ('production' | 'development' | 'test')
NODE_ENV=production

# Server Network Configuration
PORT=3000
HOST=0.0.0.0

# Persistence Engine Configuration ('postgres' for production, 'sqlite' for dev/test)
DB_CLIENT=postgres

# PostgreSQL Connection String (Required when DB_CLIENT=postgres in production)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://municipal_user:change_me_in_production_password@postgres:5432/municipal_waste_db

# Connection Pool Sizing
DB_POOL_MIN=2
DB_POOL_MAX=10

# Security Secrets (Must be high-entropy, >= 16 characters, NOT default values)
JWT_SECRET=change_me_to_a_secure_high_entropy_secret_at_least_32_chars
WEBHOOK_HMAC_SECRET=change_me_to_a_secure_hmac_secret_at_least_32_chars

# HTTP Security & Rate Limiting
CORS_ORIGIN=*
HSTS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Observability
LOG_LEVEL=info

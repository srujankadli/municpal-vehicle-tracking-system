# ====================================================================
# Municipal Solid Waste Monitoring System — Environment Configuration
# ====================================================================
# Copy this file to .env for local development or set these variables in
# your production hosting platform / secret manager.
#
# IMPORTANT: In production (NODE_ENV=production):
# 1. JWT_SECRET and WEBHOOK_HMAC_SECRET must be cryptographically random
#    strings (minimum 32 characters) and cannot use the development defaults.
# 2. CORS_ORIGIN should be restricted to your production domain(s).
# 3. For SQLite persistence, ensure DATABASE_PATH points to a persistent volume.
# ====================================================================

# Runtime Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Configuration (SQLite default / PostgreSQL optional)
DB_CLIENT=sqlite
DATABASE_PATH=./data/municipal_waste.db
# DATABASE_URL=postgresql://user:password@hostname:5432/municipal_waste

# Cryptographic Authentication & Webhook Secrets
# (Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change_me_to_a_secure_high_entropy_secret_at_least_32_chars
WEBHOOK_HMAC_SECRET=change_me_to_a_secure_hmac_secret_at_least_32_chars

# Network & Security
CORS_ORIGIN=https://your-production-domain.gov.in
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
HSTS_ENABLED=true
LOG_LEVEL=info

# Frontend API Configuration (Optional: defaults to /api/v1 relative path)
# VITE_API_BASE_URL=/api/v1
